# ============================================================
# Backend Environment Configuration
# Copy this to .env and adjust for your environment
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Prometheus
# For local K8s: kubectl port-forward svc/prometheus-operated 9090:9090
# For Docker Compose: http://prometheus:9090
PROMETHEUS_URL=http://localhost:9090

# Scrape interval in milliseconds (default: 15s)
SCRAPE_INTERVAL_MS=15000

# DEMO MODE: set to true to use synthetic data (no Prometheus needed)
# Great for development & presentation without a live cluster
DEMO_MODE=true
